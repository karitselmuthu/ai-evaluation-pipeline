# Secret Backend Selection
# env   -> read keys from this file / environment (DEFAULT; used by CI)
# vault -> read keys from the local OS-keychain-backed LLM Key Vault daemon.
#          Fails loudly at startup if the daemon is unreachable.
SECRET_BACKEND=env
# Vault daemon URL (only used when SECRET_BACKEND=vault)
VAULT_URL=http://127.0.0.1:9876

# LLM Provider Configuration
OPENAI_API_KEY=your-openai-key-here

# Gemini / Google keys power generation, judging (Antigravity SDK) and
# embeddings (retriever). In env mode either variable works.
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_API_KEY=your-gemini-key-here

# Optional extra providers used by the vault proxy rotation (llm_client.py)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=

# Evaluator Configurations
# Ragas and DeepEval also use OPENAI_API_KEY by default for LLM-as-a-judge metrics
# You can override the judge model name here:
EVAL_JUDGE_MODEL=gpt-4o

# MLflow Experiment Tracking Configuration (Optional)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=AI-Evaluation-Pipeline

# FastAPI Configuration
API_HOST=127.0.0.1
API_PORT=8000
